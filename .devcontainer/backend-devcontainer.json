{
  "name": "Python Backend Dev Container",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "backend",
  "workspaceFolder": "/app",
  "settings": {
    "python.defaultInterpreterPath": "/usr/local/bin/python"
  },
  "extensions": ["ms-python.python", "ms-python.vscode-pylance"],
  "forwardPorts": [8000],
  "shutdownAction": "stopCompose"
}
